# Copie este arquivo para .env e ajuste
PORT=8443
# CORS_ORIGINS=* aceita qualquer origem (dev). Em producao, restrinja pra
# 'https://pilotoautomaticoia.com.br,chrome-extension://<seu-id-da-extensao>'
CORS_ORIGINS=*
# TRIAL_DIAS: quantos dias de licenca nova ao emitir sem valido-ate explicito
TRIAL_DIAS=30
# TOKEN_DIAS: validade do token Ed25519 devolvido em /api/ativar
TOKEN_DIAS=10
# TOKEN_RENOVA_SEG: janela em que o cliente ja pede renovacao
TOKEN_RENOVA_SEG=259200
# Fingerprints por licenca (limite antes de bloquear)
FP_POR_LIC=3
# Token do painel admin (/admin). SETE ISTO em producao — senao o painel volta 503.
# Gere um valor aleatorio: openssl rand -base64 32
ADMIN_TOKEN=
# === IA (chat automatico) ===
# Provider: 'gemini' (gratis, padrao) ou 'anthropic' (pago).
# Se deixar vazio, escolhe automaticamente: usa gemini se GEMINI_API_KEY estiver setada,
# senao anthropic. Sem nenhuma chave, /api/ia/responder volta 503.
IA_PROVIDER=gemini
#
# --- Gemini (Google AI Studio — GRATIS ate 1500 req/dia, sem cartao) ---
# Pegue em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelo alternativo (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
#
# --- Anthropic (pago, usa Claude Haiku) ---
# Pegue em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Se sua chave for de ORGANIZACAO (nao de workspace especifica), passe o
# ID da workspace aqui. Se for uma chave de workspace (Tipo "Workspace"),
# deixe vazio. Encontre o ID em: console.anthropic.com/settings/workspaces
ANTHROPIC_WORKSPACE_ID=
# Opcional: modelo alternativo (default: claude-haiku-4-5-20251001)
# IA_MODEL=claude-haiku-4-5-20251001
